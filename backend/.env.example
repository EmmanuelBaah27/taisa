PORT=3000
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DB_PATH=./taisa.db
# Stateless coaching provider and conservative pre-call cost estimation.
TAISA_COACHING_PROVIDER=anthropic
TAISA_OPENAI_MODEL=
TAISA_OPENAI_INPUT_PRICE_USD_PER_MILLION_TOKENS=
TAISA_OPENAI_OUTPUT_PRICE_USD_PER_MILLION_TOKENS=
TAISA_OPENAI_MAX_OUTPUT_TOKENS=
TAISA_ANTHROPIC_MODEL=
TAISA_ANTHROPIC_INPUT_PRICE_USD_PER_MILLION_TOKENS=
TAISA_ANTHROPIC_OUTPUT_PRICE_USD_PER_MILLION_TOKENS=
TAISA_ANTHROPIC_MAX_OUTPUT_TOKENS=
# Transcription model and pre-provider duration/cost boundaries.
# Set price and monetary ceilings explicitly; blank values fail closed.
TAISA_TRANSCRIPTION_MODEL=whisper-1
TAISA_TRANSCRIPTION_MAX_DURATION_SECONDS=300
TAISA_TRANSCRIPTION_MAX_UPLOAD_BYTES=26214400
TAISA_TRANSCRIPTION_PRICE_USD_PER_MINUTE=
TAISA_AI_COST_CEILING_PER_REQUEST_USD=
TAISA_AI_COST_CEILING_DAILY_USD=
TAISA_AI_COST_CEILING_MONTHLY_USD=
# Content-free operational SQLite accounting. Horizontal replicas require a shared ledger.
TAISA_USAGE_LEDGER_PATH=./taisa-usage-ledger.sqlite
# Set to true to bypass Anthropic API and return mock responses (useful for frontend development without credits)
MOCK_AI=false
