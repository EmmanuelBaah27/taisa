PORT=3000
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DB_PATH=./taisa.db
# Transcription model and pre-provider duration/cost boundaries.
# Set price and monetary ceilings explicitly; blank values fail closed.
TAISA_TRANSCRIPTION_MODEL=whisper-1
TAISA_TRANSCRIPTION_MAX_DURATION_SECONDS=300
TAISA_TRANSCRIPTION_PRICE_USD_PER_MINUTE=
TAISA_AI_COST_CEILING_PER_REQUEST_USD=
TAISA_AI_COST_CEILING_DAILY_USD=
TAISA_AI_COST_CEILING_MONTHLY_USD=
# Set to true to bypass Anthropic API and return mock responses (useful for frontend development without credits)
MOCK_AI=false
