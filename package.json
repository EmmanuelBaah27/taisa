{
  "name": "taisa",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "shared"
  ],
  "scripts": {
    "backend": "npm run dev --workspace=backend",
    "generate:native-apple": "cd apple && ./scripts/generate-project.sh",
    "verify:native-apple": "node scripts/native-apple/verify.mjs && bash apple/scripts/verify-project.sh",
    "verify:native-apple:all": "bash scripts/native-apple/verify-all.sh # verify-generated-project.sh verify:native-contracts swift test verify:native-design-system Taisa-Dev Taisa-Preview Taisa-Personal Release verify:workflow",
    "verify:native-contracts": "node --test scripts/native-contracts/__tests__/verify-transcription-fixtures.test.mjs scripts/native-contracts/__tests__/verify-coaching-fixtures.test.mjs && node scripts/native-contracts/verify-transcription-fixtures.mjs && node scripts/native-contracts/verify-coaching-fixtures.mjs",
    "verify:native-design-system": "node --test scripts/native-apple/__tests__/verify-design-system.test.mjs && node scripts/native-apple/verify-design-system.mjs",
    "verify:workflow": "bash scripts/verify-workflow.sh"
  }
}
